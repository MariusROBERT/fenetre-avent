# Local SQLite file (Docker Compose uses /data/advent.sqlite).
DATABASE_URL=local.db

# Local dev origin; set the public HTTPS origin in production.
ORIGIN=http://localhost:3024

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Docker Compose host port (the container listens on port 3000).
APP_PORT=3024
